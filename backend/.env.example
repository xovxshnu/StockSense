# Copy to .env and adjust. Never commit .env.
APP_NAME=StockSense
# development | test | production (only development logs reset tokens).
# Defaults to production when unset.
ENVIRONMENT=development
DEBUG=false

# --- Database ---------------------------------------------------------------
# Hosted PostgreSQL (Neon/Supabase/Render/...): set DATABASE_URL. postgres:// and
# postgresql:// are accepted and normalized to the psycopg 3 driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Local development: leave DATABASE_URL unset and use the parts below instead.
# DATABASE_URL, when set, takes precedence over them.
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stocksense

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated, exact origins only:
# no "*", no trailing path. Leave empty to disable CORS (e.g. same-origin
# deployments). Credentialed CORS is intentionally off (auth is a Bearer header).
# Example for local React dev servers:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional: regex for preview deployments, e.g. https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# --- Security (REQUIRED) ----------------------------------------------------
# Signs JWTs. The app refuses to start without a value of at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
