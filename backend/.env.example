# Managed PostgreSQL connection string (Neon/Supabase/Render/etc.).
# postgres:// and postgresql:// are accepted and normalized automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=https://your-frontend.example.com

# Optional: regex for preview deployments, e.g. https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=
