# Copy to .env and adjust. Never commit .env.
APP_NAME=StockSense
# development | test | production (only development logs reset tokens)
ENVIRONMENT=development
DEBUG=false

POSTGRES_USER=stocksense
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stocksense
# Optional: overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stocksense

# Browser origins allowed to call the API (CORS), comma-separated, exact origins
# only: no "*", no trailing path. Leave empty to disable CORS (e.g. same-origin
# deployments). Example for local React dev servers:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Used by app/core/security.py to sign JWTs.
# Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
